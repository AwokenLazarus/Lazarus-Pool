# HTTPS only, as on the explorer: no includeSubDomains, no preload, so it stays easy to back out.
/*
  Strict-Transport-Security: max-age=15552000
  X-Content-Type-Options: nosniff
  Cache-Control: public, max-age=0, s-maxage=300
/static/*
  ! Cache-Control
  Cache-Control: public, max-age=600
/robots.txt
  ! Cache-Control
  Cache-Control: public, max-age=0, s-maxage=3600
/sitemap.xml
  ! Cache-Control
  Cache-Control: public, max-age=0, s-maxage=3600
/sitemap-en.xml
  ! Cache-Control
  Cache-Control: public, max-age=0, s-maxage=3600
/sitemap-zh.xml
  ! Cache-Control
  Cache-Control: public, max-age=0, s-maxage=3600
/llms.txt
  ! Cache-Control
  Cache-Control: public, max-age=0, s-maxage=3600
/stratum-protocol.md
  Content-Type: text/markdown; charset=utf-8
# The *.pages.dev hosts serve the same site as the custom domain; keep them out of search results.
https://:project.pages.dev/*
  X-Robots-Tag: noindex
https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
