# No Content-Security-Policy on purpose: the Angular app, Google Fonts and the cross-origin pool
# API calls would all break. _worker.js sets the same three headers on what it serves.
/*
  Strict-Transport-Security: max-age=15552000
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
/resources/*
  Cache-Control: public, max-age=3600
/resources/config.*
  ! Cache-Control
  Cache-Control: public, max-age=300
/resources/customize.*
  ! Cache-Control
  Cache-Control: public, max-age=300
/lazarus/*
  Cache-Control: public, max-age=300
/sitemap.xml
  Cache-Control: public, max-age=0, s-maxage=3600
# The licence files have no extension, so Pages would not call them text. They are files the
# footer links to, not pages, so they stay out of search results (INDEXING.md).
/lazarus/NOTICE
  Content-Type: text/plain; charset=utf-8
  X-Robots-Tag: noindex
/lazarus/LICENSE
  Content-Type: text/plain; charset=utf-8
  X-Robots-Tag: noindex
/lazarus/COPYING.md
  X-Robots-Tag: noindex
/resources/mining-pools/lazarus.svg
  ! Cache-Control
  Cache-Control: public, max-age=300
